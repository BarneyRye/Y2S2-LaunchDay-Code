000025d4 <BME_getComp>:
    msb = (uint8_t)I2C_MasterReceiveByte(BME280_ADDR, BME280_HUM_MSB);
    lsb = (uint8_t)I2C_MasterReceiveByte(BME280_ADDR, BME280_HUM_LSB);
    data->humidity = ((uint32_t)msb << 8) | lsb;
}

